        <!-- Legend -->
        <mxCell id="legend" value="Legend:&#xa;──── Association with messages&#xa;- - - - System-initiated notification&#xa;&#xa;Main Workflows:&#xa;• Create Branch (1-6)&#xa;• Assign Branch Admin (7-12)&#xa;• Add Salesperson (13-19)&#xa;• Update Branch (20-22)&#xa;• Delete Branch (23-30)&#xa;• View All Branches (31-33)" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="280" height="210" as="geometry" />
        </mxCell>
        
        <!-- Additional Notes -->
        <mxCell id="note1" value="Key Interactions:&#xa;&#xa;1. Super Admin authenticates via Authentication System&#xa;2. Create Branch: Validates and saves branch data&#xa;3. Branch creation logged to Activity Log Service&#xa;4. Assign Branch Admin: Creates user account&#xa;5. Welcome email sent to new Branch Admin&#xa;6. Add Salesperson: Creates account and assigns to branch&#xa;7. Login credentials sent via Notification Service&#xa;8. Update Branch: Modifies existing branch data&#xa;9. Delete Branch: Checks for active operations first&#xa;10. If active operations exist, deletion is prevented&#xa;11. If no active operations, soft delete and reassign users&#xa;12. Affected users notified of reassignment&#xa;13. View Branches: Queries and returns all branch data" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="320" height="280" as="geometry" />
        </mxCell>
        
        <!-- Component Descriptions -->
        <mxCell id="components" value="Components:&#xa;&#xa;• Authentication System: Handles Super Admin login&#xa;• Branch Management Service: Core branch operations&#xa;• User Management Service: User account management&#xa;• Database: Stores all persistent data&#xa;• Notification Service: Email notifications&#xa;• Activity Log Service: Audit trail logging" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="880" width="320" height="180" as="geometry" />
        </mxCell>
        
        <!-- Business Rules -->
        <mxCell id="rules" value="Business Rules:&#xa;&#xa;• Branches cannot be deleted if they have active operations&#xa;• Branch deletion is soft delete (logical, not physical)&#xa;• All user assignments trigger email notifications&#xa;• Branch admins can be assigned to multiple branches&#xa;• Salespersons are assigned to specific branches&#xa;• All operations are logged for audit purposes&#xa;• Branch data includes: location, contact, details&#xa;• User data validation occurs before account creation" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="880" width="340" height="220" as="geometry" />
        </mxCell>
        
        <!-- Security Notes -->
        <mxCell id="security" value="Security Considerations:&#xa;&#xa;• Authentication required before any operation&#xa;• Only Super Admin can manage branches&#xa;• User credentials securely generated&#xa;• Activity logging for all operations&#xa;• Branch reassignment maintains data integrity&#xa;• Validation at multiple layers (UI, Service, DB)" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" vertex="1" parent="1">
